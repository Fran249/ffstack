---
import { getLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const steps = t("home.processSteps") as unknown as Array<{ number: string; title: string; desc: string }>;
---

<section id="process" class="px-6 pb-16 md:px-16 md:pb-24">
	<div class="mx-auto w-full max-w-5xl border-t border-white/10 pt-14 md:pt-16">
		<h2 class="max-w-[28ch] text-[2rem] leading-[1.05] font-extrabold tracking-[-0.03em] md:text-[2.5rem] text-white">
			{t("home.processTitle")}
		</h2>

		<div class="mt-10 flex flex-col gap-6 md:mt-12">
			{
				steps.map((step, i) => (
					<article class="flex gap-5 md:gap-7 relative">
						<span class="shrink-0 w-14 text-right text-3xl font-extrabold text-accent/30 md:w-16 md:text-4xl">
							{step.number}
						</span>
						<div class="flex-1 pt-1">
							<h3 class="text-lg font-semibold text-white md:text-xl">
								{step.title}
							</h3>
							<p class="mt-2 text-base leading-relaxed text-white/60">
								{step.desc}
							</p>
						</div>
						
					</article>
				))
			}
		</div>
	</div>
</section>