---
import { getLocale, useTranslations } from "../i18n/utils";

export interface Props {
	/** Project slug; scopes the view-transition name. */
	slug: string;
	/** Human label (company name), used in accessible names. */
	label: string;
	/** Image URLs in display order; the first one is the poster/thumbnail. */
	images: string[];
}

const { slug, label, images } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const count = images.length;
const multiple = count > 1;
const pad = (value: number) => String(value).padStart(2, "0");
---

<div
	class="project-carousel"
	data-carousel
	data-count={count}
	role="region"
	aria-roledescription="carousel"
	aria-label={`${t("project.galleryLabel")}: ${label}`}
>
	<div
		class="relative touch-pan-y focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
		data-viewport
		role="group"
		aria-label={t("project.galleryLabel")}
		tabindex="0"
	>
		<!--
			The frame carries the same view-transition name as the /hire-me card
			image, so the card morphs into this box (and back). It wraps only the
			image track: the controls stay outside so the morph animates just the
			media, and the frame's on-screen position does not depend on which
			slide is active.
		-->
		<div
			class="overflow-hidden rounded-xl border border-white/10 bg-night-surface"
			transition:name={`project-${slug}-image`}
		>
			<div class="flex w-full" data-track>
				{
					images.map((src, i) => (
						<div
							class="w-full shrink-0"
							data-slide
							aria-hidden={i === 0 ? undefined : "true"}
						>
							<img
								src={src}
								alt={`${t("project.slideAltPrefix")} ${i + 1} — ${label}`}
								loading={i === 0 ? "eager" : "lazy"}
								decoding="async"
								draggable="false"
								class="aspect-[11/5] w-full object-cover select-none"
							/>
						</div>
					))
				}
			</div>
		</div>

		{
			multiple && (
				<>
					<div class="pointer-events-none absolute inset-0 flex items-center justify-between px-3 md:px-4">
						<button
							type="button"
							data-prev
							aria-label={t("project.prevImage")}
							class="cursor-pointer pointer-events-auto inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-night/75 text-lg text-white/80 backdrop-blur-sm transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:pointer-events-none disabled:opacity-30 md:h-11 md:w-11"
						>
							<span aria-hidden="true">←</span>
						</button>
						<button
							type="button"
							data-next
							aria-label={t("project.nextImage")}
							class="cursor-pointer pointer-events-auto inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 bg-night/75 text-lg text-white/80 backdrop-blur-sm transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:pointer-events-none disabled:opacity-30 md:h-11 md:w-11"
						>
							<span aria-hidden="true">→</span>
						</button>
					</div>

					<p
						aria-hidden="true"
						class="absolute top-3 right-3 rounded-full bg-night/80 px-2.5 py-1 text-[0.6875rem] font-semibold tracking-[0.12em] text-white/80 tabular-nums md:top-4 md:right-4"
					>
						<span data-counter-current>{pad(1)}</span> / {pad(count)}
					</p>
				</>
			)
		}
	</div>

	{
		multiple && (
			<div class="mt-3 flex gap-2 overflow-x-auto pb-1 md:mt-4 md:gap-3" data-thumbs>
				{images.map((src, i) => (
					<button
						type="button"
						data-thumb
						data-index={i}
						aria-label={`${t("project.goToImage")} ${i + 1}`}
						aria-current={i === 0 ? "true" : undefined}
						class="cursor-pointer shrink-0 overflow-hidden rounded-lg border border-white/10 opacity-55 transition-opacity hover:opacity-100 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-[current=true]:border-accent aria-[current=true]:opacity-100"
					>
						<img
							src={src}
							alt=""
							aria-hidden="true"
							loading="lazy"
							decoding="async"
							draggable="false"
							class="aspect-[11/5] w-24 object-cover select-none md:w-28"
						/>
					</button>
				))}
			</div>
		)
	}
</div>

<script>
	function initProjectCarousels() {
		const reduced = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		document.querySelectorAll("[data-carousel]").forEach((root) => {
			// Idempotent: a second init (e.g. after a view-transition swap of an
			// unchanged node) must not stack duplicate listeners.
			if (root.dataset.ready === "true") return;

			const track = root.querySelector("[data-track]");
			const viewport = root.querySelector("[data-viewport]");
			const prev = root.querySelector("[data-prev]");
			const next = root.querySelector("[data-next]");
			const current = root.querySelector("[data-counter-current]");
			const slides = Array.from(root.querySelectorAll("[data-slide]"));
			const thumbs = Array.from(root.querySelectorAll("[data-thumb]"));

			if (!track || !viewport || slides.length < 2) return;

			root.dataset.ready = "true";

			const total = slides.length;
			const pad = (value) => String(value).padStart(2, "0");
			let index = 0;

			track.style.transitionProperty = reduced ? "none" : "transform";
			track.style.transitionDuration = reduced ? "0ms" : "500ms";
			track.style.transitionTimingFunction = "cubic-bezier(0.4, 0, 0.2, 1)";

			function render() {
				track.style.transform = "translateX(-" + index * 100 + "%)";

				slides.forEach((slide, i) => {
					if (i === index) slide.removeAttribute("aria-hidden");
					else slide.setAttribute("aria-hidden", "true");
				});

				thumbs.forEach((thumb, i) => {
					if (i === index) thumb.setAttribute("aria-current", "true");
					else thumb.removeAttribute("aria-current");
				});

				if (current) current.textContent = pad(index + 1);
				if (prev) prev.disabled = index === 0;
				if (next) next.disabled = index === total - 1;
			}

			function go(target) {
				index = Math.min(Math.max(target, 0), total - 1);
				render();
			}

			if (prev) prev.addEventListener("click", () => go(index - 1));
			if (next) next.addEventListener("click", () => go(index + 1));

			thumbs.forEach((thumb, i) => {
				thumb.addEventListener("click", () => go(i));
			});

			// Keyboard: works from the viewport or any control inside the carousel.
			root.addEventListener("keydown", (event) => {
				if (event.key === "ArrowLeft") {
					event.preventDefault();
					go(index - 1);
				} else if (event.key === "ArrowRight") {
					event.preventDefault();
					go(index + 1);
				} else if (event.key === "Home") {
					event.preventDefault();
					go(0);
				} else if (event.key === "End") {
					event.preventDefault();
					go(total - 1);
				}
			});

			// Touch / pointer swipe. `touch-pan-y` on the viewport keeps vertical
			// scrolling native while we claim horizontal gestures.
			const threshold = 40;
			let startX = 0;
			let startY = 0;
			let tracking = false;

			viewport.addEventListener("pointerdown", (event) => {
				if (event.pointerType === "mouse" && event.button !== 0) return;
				startX = event.clientX;
				startY = event.clientY;
				tracking = true;
			});

			viewport.addEventListener("pointerup", (event) => {
				if (!tracking) return;
				tracking = false;

				const dx = event.clientX - startX;
				const dy = event.clientY - startY;

				if (Math.abs(dx) < threshold || Math.abs(dx) <= Math.abs(dy)) return;
				go(index + (dx < 0 ? 1 : -1));
			});

			viewport.addEventListener("pointercancel", () => {
				tracking = false;
			});

			render();
		});
	}

	initProjectCarousels();
	document.addEventListener("astro:after-swap", initProjectCarousels);
</script>
