---
import { getLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<section id="contact" class="px-6 pt-16 pb-20 md:px-16 md:pt-24 md:pb-28">
	<div class="mx-auto w-full max-w-5xl">
		<h2 class="max-w-[22ch] text-[2rem] leading-[1.05] font-extrabold tracking-[-0.03em] md:text-[2.25rem]">
			{t("contact.title")}
		</h2>

		<p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-muted md:text-xl">
			{t("contact.intro")}
		</p>

		<form class="mt-10 flex max-w-[40rem] flex-col gap-6" method="post" action="#">
			<div class="flex flex-col gap-2">
				<label for="name" class="text-sm font-semibold">{t("contact.nameLabel")}</label>
				<input
					type="text"
					id="name"
					name="name"
					placeholder={t("contact.namePlaceholder")}
					required
					class="rounded-md border border-line bg-white px-4 py-3 text-base outline-none transition-colors placeholder:text-muted focus:border-ink"
				/>
			</div>

			<div class="flex flex-col gap-2">
				<label for="email" class="text-sm font-semibold">{t("contact.emailLabel")}</label>
				<input
					type="email"
					id="email"
					name="email"
					placeholder={t("contact.emailPlaceholder")}
					required
					class="rounded-md border border-line bg-white px-4 py-3 text-base outline-none transition-colors placeholder:text-muted focus:border-ink"
				/>
			</div>

			<div class="flex flex-col gap-2">
				<label for="message" class="text-sm font-semibold">{t("contact.messageLabel")}</label>
				<textarea
					id="message"
					name="message"
					rows="5"
					placeholder={t("contact.messagePlaceholder")}
					required
					class="resize-y rounded-md border border-line bg-white px-4 py-3 text-base outline-none transition-colors placeholder:text-muted focus:border-ink"></textarea>
			</div>

			<button
				type="submit"
				class="cursor-pointer btn-fill mt-2 inline-flex min-w-[14rem] justify-center border border-ink bg-transparent px-8 py-3.5 text-sm font-bold text-ink"
				style="--fill-color: #131313; --fill-text: #ffffff"
			>
				{t("contact.submit")}
			</button>
		</form>
	</div>
</section>
