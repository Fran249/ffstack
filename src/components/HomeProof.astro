---
import { getLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const testimonials = t("home.testimonials") as unknown as Array<{
	quote: string;
	author: string;
	role: string;
}>;
---

<section class="px-6 pb-16 md:px-16 md:pb-24">
	<div class="mx-auto w-full max-w-5xl border-t border-white/10 pt-14 md:pt-16">
		<h2 class="max-w-[28ch] text-[2rem] leading-[1.05] font-extrabold tracking-[-0.03em] md:text-[2.5rem] text-white">
			{t("home.proofTitle")}
		</h2>

		<div class="mt-10 grid gap-6 md:mt-12 md:grid-cols-3">
			{
				testimonials.map((testimonial) => (
					<article class="rounded-xl bg-night-surface p-7 md:p-8 border border-white/10">
						<p class="text-lg leading-relaxed text-white md:text-xl">
							"{testimonial.quote}"
						</p>
						<div class="mt-6 pt-4 border-t border-white/10">
							<p class="font-semibold text-white">{testimonial.author}</p>
							<p class="text-sm text-white/45">{testimonial.role}</p>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>