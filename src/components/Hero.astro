---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const line1 = t("hero.line1");
const line2 = t("hero.line2");
---

<section class="px-6 pt-14 pb-14 md:px-16 md:pt-24 md:pb-16">
	<div class="mx-auto w-full max-w-5xl">
		<div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-14">
			<!-- Text column -->
			<div class="w-full lg:max-w-[28rem] lg:shrink-0 lg:pt-2">
				<p class="text-xs font-medium tracking-[0.14em] text-muted uppercase md:text-[0.8125rem]">
					{t("hero.eyebrow")}
				</p>

				<h1
					class="hero-title relative mt-6 max-w-[14ch] text-[3rem] leading-[0.95] font-extrabold tracking-[-0.04em] md:mt-8 md:text-[4rem] md:leading-[0.95] lg:text-[4.5rem]"
				>
					{/*
						Layout safety: an invisible copy of the full headline reserves the exact
						height, and the animated copy sits in an absolutely positioned layer on
						top. The h1 therefore measures its full text in any locale, at any font
						size, and the typewriter can never shift the page flow.
					*/}
					<span class="invisible block" aria-hidden="true">
						<span class="inline-block">{line1}</span><br />
						<span class="inline-block">{line2}</span>
					</span>
					<span class="pointer-events-none absolute inset-0 block" aria-hidden="true">
						<span class="hero-line">{line1}</span><br />
						<span class="hero-line">{line2}</span>
					</span>
					<span class="sr-only">{line1} {line2}</span>
				</h1>

				<p class="mt-7 max-w-[52ch] text-lg leading-relaxed text-muted md:mt-9 md:text-xl">
					{t("hero.intro")}
				</p>

				<a
					href="#contact"
					class="btn-fill mt-9 inline-flex border border-ink bg-transparent px-6 py-3.5 text-sm font-bold text-ink"
					style="--fill-color: #cdf556"
				>
					{t("hero.ctaPrimary")}
				</a>
			</div>

			<!-- Visual column -->
			<div class="w-full lg:flex-1">
				<div class="hero-card reveal rounded-2xl bg-sky p-5 md:p-7">
					<p class="text-xs font-semibold tracking-[0.08em] text-ink uppercase md:text-sm">
						{t("hero.cardEyebrow")}
					</p>

					<!-- Black panel -->
					<div class="mt-5 rounded-xl bg-night p-5 md:mt-6 md:p-6 lg:p-7">
						<p class="text-sm font-medium text-white/80 md:text-[0.9375rem]">
							{t("hero.cardLabel")}
						</p>
						<h2
							class="mt-3 text-[1.625rem] leading-[1.05] font-extrabold tracking-[-0.025em] text-white md:mt-4 md:text-[2rem] lg:text-[2.25rem]"
						>
							{t("hero.cardTitle")}
						</h2>

						<div class="mt-6 grid grid-cols-2 gap-3 md:mt-7 md:gap-4">
							<div class="rounded-lg bg-accent p-4 md:p-5">
								<p class="text-sm font-semibold text-ink">{t("hero.frontendLabel")}</p>
								<p class="mt-2 text-lg md:text-xl font-bold leading-snug text-ink">
									{t("hero.frontendNote")}
								</p>
							</div>
							<div class="rounded-lg bg-page p-4 md:p-5">
								<p class="text-sm font-semibold text-ink">{t("hero.backendLabel")}</p>
								<p class="mt-2 text-lg md:text-xl font-bold leading-snug text-ink">
									{t("hero.backendNote")}
								</p>
							</div>
						</div>
					</div>

					<!-- Button below panel -->
					<a
						href={getRelativeLocaleUrl(locale, "hire-me")}
						class="btn-fill mt-5 inline-flex border border-ink bg-transparent px-5 py-3 text-sm font-bold text-ink md:mt-6"
						style="--fill-color: #ffffff"
					>
						{t("hero.ctaSecondary")}
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	let runId = 0;
	const timers: number[] = [];

	function clearTimers() {
		timers.forEach((id) => clearTimeout(id));
		timers.length = 0;
	}

	function wait(ms: number): Promise<void> {
		return new Promise((resolve) => {
			timers.push(window.setTimeout(resolve, ms));
		});
	}

	async function typeLine(
		el: HTMLElement,
		text: string,
		run: number,
	): Promise<boolean> {
		el.classList.add("is-typing");
		for (let i = 1; i <= text.length; i++) {
			await wait(text[i - 1] === "." ? 350 : 55 + Math.random() * 45);
			if (run !== runId) return false;
			el.textContent = text.slice(0, i);
		}
		el.classList.remove("is-typing");
		return true;
	}

	async function deleteLine(
		el: HTMLElement,
		run: number,
	): Promise<boolean> {
		el.classList.add("is-typing");
		let text = el.textContent || "";
		while (text.length > 0) {
			await wait(30 + Math.random() * 25);
			if (run !== runId) return false;
			text = text.slice(0, -1);
			el.textContent = text;
		}
		el.classList.remove("is-typing");
		return true;
	}

	async function runTypewriter() {
		const h1 = document.querySelector<HTMLElement>(".hero-title");
		if (!h1) return;
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
			return; // static text fallback (HTML already renders full text)

		const lines = Array.from(
			h1.querySelectorAll<HTMLElement>(".hero-line"),
		);
		const texts = lines.map((line) => line.textContent || "");
		const run = ++runId;
		clearTimers();

		while (run === runId) {
			lines.forEach((line) => (line.textContent = ""));
			await wait(500);
			if (run !== runId) return;

			for (let i = 0; i < lines.length; i++) {
				if (!(await typeLine(lines[i], texts[i], run))) return;
				await wait(150);
				if (run !== runId) return;
			}

			await wait(2200); // hold full text before deleting
			if (run !== runId) return;

			for (let i = lines.length - 1; i >= 0; i--) {
				if (!(await deleteLine(lines[i], run))) return;
				await wait(120);
				if (run !== runId) return;
			}

			await wait(600);
		}
	}

	// astro:page-load fires on initial load AND after every View Transition
	document.addEventListener("astro:page-load", runTypewriter);
</script>
