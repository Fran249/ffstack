---
import "@fontsource-variable/inter";
import "../styles/globals.css";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocale, stripLocale, useTranslations } from "../i18n/utils";

interface Props {
	title?: string;
	description?: string;
	theme?: "light" | "dark";
}

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const {
	title = t("site.title"),
	description = t("site.description"),
	theme = "light",
} = Astro.props;

// Same page, other locale — used for the hreflang alternates.
const routePath = stripLocale(Astro.url.pathname);

// One language-neutral OG card per locale; both are 1200×630 PNGs in /public.
// Absolute, because social scrapers require an absolute og:image URL.
const site = Astro.site ?? new URL("https://ffstack.vercel.app");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(locale === "es" ? "/og.png" : "/og-en.png", site);
---

<!doctype html>
<html lang={locale} class:list={[theme === "dark" && "bg-night text-white"]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#131313" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={t("brand.name")} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content={locale === "es" ? "es_ES" : "en_US"} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="alternate" hreflang="es" href={getRelativeLocaleUrl("es", routePath)} />
		<link rel="alternate" hreflang="en" href={getRelativeLocaleUrl("en", routePath)} />
		<link rel="alternate" hreflang="x-default" href={getRelativeLocaleUrl("es", routePath)} />
		<link rel="canonical" href={canonical} />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body
		data-locale={locale}
		class:list={[
			theme === "dark" ? "bg-night text-white" : "bg-page text-ink",
		]}
	>
		<slot />
		<script>
			function initReveal() {
				const prefersReduced = window.matchMedia(
					"(prefers-reduced-motion: reduce)",
				).matches;
				if (prefersReduced) {
					document
						.querySelectorAll(".reveal")
						.forEach((el) => el.classList.add("is-visible"));
					return;
				}

				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
				);

				document
					.querySelectorAll(".reveal:not(.is-visible)")
					.forEach((el) => observer.observe(el));
			}

			// ClientRouter replaces <body> (which carries `data-locale`) but keeps the
			// <html> element, so `lang` would otherwise go stale after navigating
			// between locales client-side.
			function syncLang() {
				const locale = document.body.dataset.locale;
				if (locale) document.documentElement.lang = locale;
			}

			// Initial load
			initReveal();
			syncLang();

			// Re-init after View Transition swap
			document.addEventListener("astro:after-swap", initReveal);
			document.addEventListener("astro:after-swap", syncLang);
		</script>
	</body>
</html>
